# 🍎 24판(09-15 09:5x) = v13.48 그대로(배포 갈래 run 2505 success) — 23판 ＋ 재로그인 합치기 ＋ 권한 문구(목적·범위) ＋ 앱 세션 v13.47 계측. ⭐App Store 1.0 승인(09-15 08:39) 뒤 «업데이트(1.0.1)»로 제출할 판.
# 🍎 20판(09-14 00:5x) = 19판 ＋ 아이폰 가져오기에 「사진 앱에 있는 사진 바로 한끼로」 카드 복귀(창업자 "갤러리에서 가져오기되자나" · 19판 실물로 사진 앱 공유가 되는 걸 본 뒤) ＋ AI 「썬다요」 다듬기. ⭐심사에 넣는 빌드.
# 🍎 19판(09-13 22:5x) = 18판(run 34760053721 success · 13.33 (18)) ＋ 「같은 그림은 하나만」(iosShare.js · 17판 실물에서 같은 캡처 4번 → 열쇠 4개).
# 🍎 18판(09-13 22:3x) = 17판 실물 뒤 — 공유 시트에 「한끼」 ✅ · 저장 ✅(임시보관함에 들어옴) · 그러나 앱 깨우기 비공식 코드에서 죽어 「담았어요」 창이 안 보이고 시트가 안 닫힘 → 그 코드 제거 ＋ 창 1.5초.
# 🍎 17판(09-13 22:1x) = 16판 ＋ 부품 App ID(kr.hankki.app.share)에 그룹 배정 「Enabled App Groups (1)」 ＋ Save(창업자 캡처) ＋ v13.33 합침(가지 파서 · AI 고지 절반 · tidy 워커 차례 고침) ＋ 편집 다듬기 끝말.
#    16판 실측 = archive 에서 「Provisioning profile … doesn't support the group.kr.hankki.app App Group」 — 부품 ID 는 App Groups 를 «켜기만» 하고 그룹 배정(Configure)이 빠져 있었다. 본체 ID 는 통과.
# 🍎 16판(09-13 20:5x · 포털 = App Group group.kr.hankki.app · App ID 둘에 배정 — 실은 본체만 · 부품은 (0)) = Share Extension 첫 판 — 공유 시트에 「한끼」가 뜨고, 받은 것은 App Group inbox 에 두었다가 앱이 열릴 때 담는다(scripts/add-share-extension.rb · ShareIntakePlugin).
#    ⛔ 포털 선행 = App Group group.kr.hankki.app 등록 + kr.hankki.app / kr.hankki.app.share 두 App ID 에 배정(창업자 1회). 안 돼 있으면 match 에서 죽는다.
# 🍎 15판(09-13 20:0x) = 14판 ＋ 배포 갈래 v13.32(추석·캡처 레시피) 합침 ＋ 아이폰 안내에 실제 단추 아이콘(가져오기 ＋ · 카메라) ＋ 안내 머리 제목.
# 🍎 14판(09-13 19:4x) = 심사 제출(15:50) 취소 뒤 다시 제출용 — 아이폰에서 없는 길(공유 시트 → 한끼)·안 되는 부품(<a download>·진동·SW 갱신)을 안 가르치게 12곳 갈라 놓음(_repro-아이폰안내-0913).
# ⛔ 이 파일은 «수동 서명»이다 — Xcode 의 자동 서명·클라우드 관리 인증서는 안 쓴다.
# ⛔ nuke 는 팀의 «배포» 인증서·프로필을 전부 지운다. 지금 팀엔 러너가 만든 것(＋6판이 만든 클라우드 관리 인증서)뿐이라 괜찮다.
#    나중에 맥에서 손으로 만든 배포 인증서가 생기면 이 줄을 다시 본다.
# ⛔ 열쇠(ASC_API_KEY_P8)는 환경변수로만 온다 — 파일로 안 남기고, 로그에 안 찍는다(fastlane 이 sensitive 로 가림).

default_platform(:ios)

BUNDLE_ID = "kr.hankki.app"
EXT_ID    = "kr.hankki.app.share"     # 🍎 16판~ Share Extension(공유 시트의 「한끼」) — 별도 App ID · 별도 프로필로 서명
APP_IDS   = [BUNDLE_ID, EXT_ID]
TEAM_ID   = "6YM72N6FPD"
PROJECT   = "ios/App/App.xcodeproj"

platform :ios do
  desc "기기 없이 서명 → build/out/App.ipa · upload:true 면 TestFlight 까지"
  lane :release do |opts|
    # 1) 임시 키체인 (없으면 CI 에서 서명이 멈춘다 — fastlane/docs github.md)
    setup_ci

    # 2) API 열쇠 — 파일 없이 내용으로
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8"),
      in_house: false
    )

    # 3) match 저장소 = 이 러너 안의 «빈 로컬 git» (판이 끝나면 사라진다 · 아무 데도 안 남는다)
    #    MATCH_PASSWORD 도 판마다 난수 — 워크플로가 넣어 준다.
    store = {
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_LOCAL_REPO"),   # file:///…/match-store.git
      git_branch: "main",
      shallow_clone: false,
      api_key: api_key,
      team_id: TEAM_ID,
      skip_docs: true
    }

    # 4) 팀의 «배포» 인증서·프로필을 비운다 — 애플이 팀당 배포 인증서 하나만 허용하므로 «항상 0 → 1»로 간다
    #    ⚠️ 9판 실측: 이 액션의 type 은 match 종류(appstore·adhoc·development…)를 받는다 — 명령줄의 "distribution" 이 아니라 "appstore".
    #    ⚠️ 10판 실측: setup_ci 가 MATCH_READONLY=true 를 켠다 → nuke 가 "doesn't delete anything when running with --readonly" 로 죽음 → readonly: false 를 명시.
    match_nuke(store.merge(type: "appstore", readonly: false, skip_confirmation: true, safe_remove_certs: false))

    # 5) 새 배포 인증서 ＋ App Store 프로필 만들고 키체인·프로필 폴더에 설치
    match(store.merge(
      type: "appstore",
      app_identifier: APP_IDS,   # match 는 배열을 받는다(match/options.rb) · ID 마다 프로필 하나씩 만든다 · ⛔ App ID 는 안 만들어 준다(포털에 먼저 있어야)
      readonly: false,
      generate_apple_certs: true,
      force: true,
      skip_confirmation: true
    ))

    profile_name = ENV.fetch("sigh_#{BUNDLE_ID}_appstore_profile-name")
    ext_profile  = ENV.fetch("sigh_#{EXT_ID}_appstore_profile-name")
    UI.important("프로필 = #{profile_name} · 부품 = #{ext_profile}")

    # 6) 프로젝트를 «수동 서명»으로 — 이 프로필·Apple Distribution 인증서로만 서명한다
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )
    # 이 액션은 bundle_identifier 를 «고른 타깃 전부»에 박는다 → 부품은 따로 한 번 더(다른 ID · 다른 프로필)
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      bundle_identifier: EXT_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ext_profile,
      targets: ["ShareExtension"]
    )

    # 7) archive → export (.ipa) — 권한(App.entitlements 의 applesignin)은 여기서 서명하며 박힌다
    build_app(
      project: PROJECT,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      output_directory: "build/out",
      output_name: "App.ipa",
      xcargs: %(MARKETING_VERSION="#{ENV.fetch('MARKETING_VERSION')}" CURRENT_PROJECT_VERSION="#{ENV.fetch('BUILD_NUMBER')}"),
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name, EXT_ID => ext_profile },
        signingStyle: "manual",
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false
      }
    )

    # 8) upload:true 면 TestFlight 로 (처리 완료까지 안 기다린다 — 러너 시간 아낌)
    if opts[:upload].to_s == "true"   # 명령줄 `upload:true` 는 문자열로 온다 — "false" 도 참이 되니 글자로 비교
      upload_to_testflight(
        api_key: api_key,
        ipa: "build/out/App.ipa",
        skip_waiting_for_build_processing: true
      )
      UI.success("TestFlight 로 올렸다 — App Store Connect 에서 처리 중 → 딸 폰 TestFlight 업데이트")
    end
  end
end

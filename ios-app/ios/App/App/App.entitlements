<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 🍎 2026-09-08 큰 틀 4 — 「Sign in with Apple」 권한(capability). 부품 원문(setup-apple.md) = Xcode 에서 이 capability 를 켠다.
	     ⚠️ 서명 없는 빌드(지금)엔 영향 없다 · 9/13 가입 뒤 App ID 에 같은 capability 를 켜야 «서명 빌드»가 통과한다. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- 🍎 2026-09-13 Share Extension 과 같은 저장칸(App Group). 앱·부품 «양쪽» 권한 파일에 있어야 한다(Apple App Groups Entitlement 원문).
	     ⛔ 개발자 사이트에서 그룹 등록 + App ID 배정을 안 하면 match 프로필에 이 권한이 없어 서명이 죽는다. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.kr.hankki.app</string>
	</array>
</dict>
</plist>
